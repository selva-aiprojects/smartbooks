generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Company {
  id                String            @id @default(uuid())
  name              String
  subdomain         String            @unique
  currency          String            @default("INR")
  plan              String            @default("enterprise")
  contactEmail      String?
  contactPhone      String?
  seatLimit         Int               @default(15)
  billingCycle      String            @default("Annual")
  subscriptionStatus String           @default("Active")
  nextBillingDate   String?
  gstin             String?
  twoFactorEnabled  Boolean           @default(false)
  sessionTimeoutMinutes Int           @default(30)
  entityType        String?           @default("parent")
  displayName       String?
  parentCompanyId   String?
  parentCompany     Company?          @relation("EntityHierarchy", fields: [parentCompanyId], references: [id])
  childCompanies    Company[]         @relation("EntityHierarchy")
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  users             User[]
  roles             Role[]
  accounts          Account[]
  entries           JournalEntry[]
  customers         Customer[]
  invoices          Invoice[]
  vendors           Vendor[]
  bills             Bill[]
  bankTransactions  BankTransaction[]
  taxRates          TaxRate[]
  items             Item[]
}

model User {
  id                 String         @id @default(uuid())
  email              String         @unique
  password           String
  name               String?
  role               String?        @default("Tenant Admin")
  status             String?        @default("Active")
  lastLogin          DateTime?
  passwordResetToken String?
  passwordResetExpires DateTime?
  companyId          String
  company            Company        @relation(fields: [companyId], references: [id])
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt
  roles              Role[]
  journalEntries     JournalEntry[]

  @@index([companyId])
}

model Role {
  id          String   @id @default(uuid())
  name        String
  companyId   String
  company     Company  @relation(fields: [companyId], references: [id])
  users       User[]
  permissions String
}

model Account {
  id        String        @id @default(uuid())
  companyId String
  company   Company       @relation(fields: [companyId], references: [id])
  name      String
  code      String
  type      String
  balance   Decimal       @default(0)
  active    Boolean       @default(true)
  entries   JournalLine[]

  @@unique([companyId, code])
  @@index([companyId])
}

model TaxRate {
  id        String   @id @default(uuid())
  companyId String
  company   Company  @relation(fields: [companyId], references: [id])
  name      String
  rate      Decimal  @db.Decimal(5, 2)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  @@index([companyId])
}

model Item {
  id        String   @id @default(uuid())
  companyId String
  company   Company  @relation(fields: [companyId], references: [id])
  name      String
  sku       String
  category  String?
  hsnCode   String?
  unit      String   @default("Nos")
  rate      Decimal  @default(0) @db.Decimal(19, 2)
  gstRate   Decimal  @default(0) @db.Decimal(5, 2)
  stock     Decimal  @default(0) @db.Decimal(19, 2)
  location  String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, sku])
  @@index([companyId])
}

model JournalEntry {
  id          String        @id @default(uuid())
  companyId   String
  company     Company       @relation(fields: [companyId], references: [id])
  date        DateTime
  description String?
  status      String        @default("Posted")
  createdById String
  createdBy   User          @relation(fields: [createdById], references: [id])
  lines       JournalLine[]

  @@index([companyId])
  @@index([companyId, date])
}

model JournalLine {
  id          String       @id @default(uuid())
  entryId     String
  entry       JournalEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  accountId   String
  account     Account      @relation(fields: [accountId], references: [id])
  amount      Decimal
  type        String
  description String?

  @@index([accountId])
}

model Customer {
  id        String    @id @default(uuid())
  companyId String
  company   Company   @relation(fields: [companyId], references: [id])
  name      String
  email     String?
  phone     String?
  address   String?
  invoices  Invoice[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([companyId])
}

model Invoice {
  id            String        @id @default(uuid())
  companyId     String
  company       Company       @relation(fields: [companyId], references: [id])
  customerId    String
  customer      Customer      @relation(fields: [customerId], references: [id])
  number        String
  issueDate     DateTime
  dueDate       DateTime
  status        String        @default("Draft")
  taxableAmount Decimal       @default(0) @db.Decimal(19, 2)
  gstRate       Decimal       @default(0) @db.Decimal(5, 2)
  gstAmount     Decimal       @default(0) @db.Decimal(19, 2)
  isInterState  Boolean       @default(false)
  totalAmount   Decimal       @default(0) @db.Decimal(19, 2)
  items         InvoiceItem[]
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([companyId])
  @@index([companyId, status])
}

model InvoiceItem {
  id          String   @id @default(uuid())
  invoiceId   String
  invoice     Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  description String
  hsnCode     String?
  quantity    Int      @default(1)
  unitPrice   Decimal  @default(0) @db.Decimal(19, 2)
  amount      Decimal  @default(0) @db.Decimal(19, 2)
  gstRate     Decimal  @default(0) @db.Decimal(5, 2)
  gstAmount   Decimal  @default(0) @db.Decimal(19, 2)
}

model Vendor {
  id        String   @id @default(uuid())
  companyId String
  company   Company  @relation(fields: [companyId], references: [id])
  name      String
  email     String?
  phone     String?
  address   String?
  bills     Bill[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId])
}

model Bill {
  id             String     @id @default(uuid())
  companyId      String
  company        Company    @relation(fields: [companyId], references: [id])
  vendorId       String
  vendor         Vendor     @relation(fields: [vendorId], references: [id])
  number         String
  billDate       DateTime
  dueDate        DateTime
  status         String     @default("Unpaid")
  taxableAmount  Decimal    @default(0) @db.Decimal(19, 2)
  gstRate        Decimal    @default(0) @db.Decimal(5, 2)
  gstAmount      Decimal    @default(0) @db.Decimal(19, 2)
  isInterState   Boolean    @default(false)
  totalAmount    Decimal    @default(0) @db.Decimal(19, 2)
  items          BillItem[]
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  @@index([companyId])
  @@index([companyId, status])
}

model BillItem {
  id          String   @id @default(uuid())
  billId      String
  bill        Bill     @relation(fields: [billId], references: [id], onDelete: Cascade)
  description String
  hsnCode     String?
  quantity    Int      @default(1)
  unitPrice   Decimal  @default(0) @db.Decimal(19, 2)
  amount      Decimal  @default(0) @db.Decimal(19, 2)
  category    String   @default("Expense")
  gstRate     Decimal  @default(0) @db.Decimal(5, 2)
  gstAmount   Decimal  @default(0) @db.Decimal(19, 2)
}

model BankTransaction {
  id             String   @id @default(uuid())
  companyId      String
  company        Company  @relation(fields: [companyId], references: [id])
  date           DateTime
  description    String
  amount         Decimal  @db.Decimal(19,2)
  type           String
  matched        Boolean  @default(false)
  matchedEntryId String?
  externalId     String?
  createdAt      DateTime @default(now())

  @@unique([companyId, externalId])
  @@index([companyId])
}
