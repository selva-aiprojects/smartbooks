generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Company {
  id                String            @id @default(uuid())
  name              String
  subdomain         String            @unique
  currency          String            @default("INR")
  plan              String            @default("enterprise")
  contactEmail      String?
  contactPhone      String?
  seatLimit         Int               @default(15)
  billingCycle      String            @default("Annual")
  subscriptionStatus String           @default("Active")
  nextBillingDate   String?
  gstin             String?
  twoFactorEnabled  Boolean           @default(false)
  sessionTimeoutMinutes Int           @default(30)
  entityType        String?           @default("parent")
  displayName       String?
  parentCompanyId   String?
  parentCompany     Company?          @relation("EntityHierarchy", fields: [parentCompanyId], references: [id])
  childCompanies    Company[]         @relation("EntityHierarchy")
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  users             User[]
  roles             Role[]
  accounts          Account[]
  entries           JournalEntry[]
  customers         Customer[]
  invoices          Invoice[]
  vendors           Vendor[]
  bills             Bill[]
  bankTransactions  BankTransaction[]
  taxRates          TaxRate[]
  items             Item[]
  auditLogs         AuditLog[]
  eWayBills         EWayBill[]
  tdsEntries        TdsEntry[]
  employees         Employee[]
  salarySlips       SalarySlip[]
}

model User {
  id                 String         @id @default(uuid())
  email              String         @unique
  password           String
  name               String?
  role               String?        @default("Tenant Admin")
  status             String?        @default("Active")
  lastLogin          DateTime?
  passwordResetToken String?
  passwordResetExpires DateTime?
  companyId          String
  company            Company        @relation(fields: [companyId], references: [id])
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt
  roles              Role[]
  journalEntries     JournalEntry[]
  invoicePayments    InvoicePayment[]
  billPayments       BillPayment[]

  @@index([companyId])
}

model Role {
  id          String   @id @default(uuid())
  name        String
  companyId   String
  company     Company  @relation(fields: [companyId], references: [id])
  users       User[]
  permissions String
}

model Account {
  id        String        @id @default(uuid())
  companyId String
  company   Company       @relation(fields: [companyId], references: [id])
  name      String
  code      String
  type      String
  balance   Decimal       @default(0)
  active    Boolean       @default(true)
  entries   JournalLine[]

  @@unique([companyId, code])
  @@index([companyId])
}

model TaxRate {
  id        String   @id @default(uuid())
  companyId String
  company   Company  @relation(fields: [companyId], references: [id])
  name      String
  rate      Decimal  @db.Decimal(5, 2)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  @@index([companyId])
}

model Item {
  id        String   @id @default(uuid())
  companyId String
  company   Company  @relation(fields: [companyId], references: [id])
  name      String
  sku       String
  category  String?
  hsnCode   String?
  unit      String   @default("Nos")
  rate      Decimal  @default(0) @db.Decimal(19, 2)
  gstRate   Decimal  @default(0) @db.Decimal(5, 2)
  stock     Decimal  @default(0) @db.Decimal(19, 2)
  location  String?
  active    Boolean  @default(true)
  tracksInventory Boolean @default(true)
  invoiceItems InvoiceItem[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, sku])
  @@index([companyId])
}

model JournalEntry {
  id          String        @id @default(uuid())
  companyId   String
  company     Company       @relation(fields: [companyId], references: [id])
  date        DateTime
  description String?
  status      String        @default("Posted")
  createdById String
  createdBy   User          @relation(fields: [createdById], references: [id])
  lines       JournalLine[]

  @@index([companyId])
  @@index([companyId, date])
}

model JournalLine {
  id          String       @id @default(uuid())
  entryId     String
  entry       JournalEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  accountId   String
  account     Account      @relation(fields: [accountId], references: [id])
  amount      Decimal
  type        String
  description String?

  @@index([accountId])
}

model Customer {
  id        String    @id @default(uuid())
  companyId String
  company   Company   @relation(fields: [companyId], references: [id])
  name      String
  email     String?
  phone     String?
  address   String?
  invoices  Invoice[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([companyId])
}

model Invoice {
  id            String        @id @default(uuid())
  companyId     String
  company       Company       @relation(fields: [companyId], references: [id])
  customerId    String
  customer      Customer      @relation(fields: [customerId], references: [id])
  number        String
  issueDate     DateTime
  dueDate       DateTime
  status        String        @default("Draft")
  taxableAmount Decimal       @default(0) @db.Decimal(19, 2)
  gstRate       Decimal       @default(0) @db.Decimal(5, 2)
  gstAmount     Decimal       @default(0) @db.Decimal(19, 2)
  isInterState  Boolean       @default(false)
  totalAmount   Decimal       @default(0) @db.Decimal(19, 2)
  irn           String?
  ackNo         String?
  ackDate       DateTime?
  signedQrCode  String?
  eWayBillNo    String?
  eWayBillDate  DateTime?
  eWayBillValidUpto DateTime?
  items         InvoiceItem[]
  payments      InvoicePayment[]
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([companyId])
  @@index([companyId, status])
}

model InvoicePayment {
  id          String   @id @default(uuid())
  invoiceId   String
  invoice     Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  amount      Decimal  @default(0) @db.Decimal(19, 2)
  date        DateTime
  method      String   @default("Cash")
  reference   String?
  createdById String?
  createdBy   User?    @relation(fields: [createdById], references: [id])
  createdAt   DateTime @default(now())

  @@index([invoiceId])
}

model InvoiceItem {
  id          String   @id @default(uuid())
  invoiceId   String
  invoice     Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  itemId      String?
  item        Item?    @relation(fields: [itemId], references: [id])
  description String
  hsnCode     String?
  quantity    Int      @default(1)
  unitPrice   Decimal  @default(0) @db.Decimal(19, 2)
  amount      Decimal  @default(0) @db.Decimal(19, 2)
  gstRate     Decimal  @default(0) @db.Decimal(5, 2)
  gstAmount   Decimal  @default(0) @db.Decimal(19, 2)

  @@index([itemId])
}

model Vendor {
  id        String   @id @default(uuid())
  companyId String
  company   Company  @relation(fields: [companyId], references: [id])
  name      String
  email     String?
  phone     String?
  address   String?
  bills     Bill[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId])
}

model Bill {
  id             String     @id @default(uuid())
  companyId      String
  company        Company    @relation(fields: [companyId], references: [id])
  vendorId       String
  vendor         Vendor     @relation(fields: [vendorId], references: [id])
  number         String
  billDate       DateTime
  dueDate        DateTime
  status         String     @default("Unpaid")
  taxableAmount  Decimal    @default(0) @db.Decimal(19, 2)
  gstRate        Decimal    @default(0) @db.Decimal(5, 2)
  gstAmount      Decimal    @default(0) @db.Decimal(19, 2)
  isInterState   Boolean    @default(false)
  totalAmount    Decimal    @default(0) @db.Decimal(19, 2)
  items          BillItem[]
  payments       BillPayment[]
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  @@index([companyId])
  @@index([companyId, status])
}

model BillPayment {
  id          String   @id @default(uuid())
  billId      String
  bill        Bill     @relation(fields: [billId], references: [id], onDelete: Cascade)
  amount      Decimal  @default(0) @db.Decimal(19, 2)
  date        DateTime
  method      String   @default("Cash")
  reference   String?
  createdById String?
  createdBy   User?    @relation(fields: [createdById], references: [id])
  createdAt   DateTime @default(now())

  @@index([billId])
}

model BillItem {
  id          String   @id @default(uuid())
  billId      String
  bill        Bill     @relation(fields: [billId], references: [id], onDelete: Cascade)
  description String
  hsnCode     String?
  quantity    Int      @default(1)
  unitPrice   Decimal  @default(0) @db.Decimal(19, 2)
  amount      Decimal  @default(0) @db.Decimal(19, 2)
  category    String   @default("Expense")
  gstRate     Decimal  @default(0) @db.Decimal(5, 2)
  gstAmount   Decimal  @default(0) @db.Decimal(19, 2)
}

model BankTransaction {
  id             String   @id @default(uuid())
  companyId      String
  company        Company  @relation(fields: [companyId], references: [id])
  date           DateTime
  description    String
  amount         Decimal  @db.Decimal(19,2)
  type           String
  matched        Boolean  @default(false)
  matchedEntryId String?
  externalId     String?
  createdAt      DateTime @default(now())

  @@unique([companyId, externalId])
  @@index([companyId])
}

model AuditLog {
  id          String   @id @default(uuid())
  companyId   String
  company     Company  @relation(fields: [companyId], references: [id])
  userId      String?
  userEmail   String?
  userName    String?
  action      String   // CREATE, UPDATE, DELETE, STATUS_CHANGE, PAYMENT, EXPORT, RECONCILE
  entityType  String   // INVOICE, BILL, JOURNAL_ENTRY, ACCOUNT, CUSTOMER, VENDOR, TAX_RATE, SETTINGS
  entityId    String
  entityRef   String?  // Reference identifier, e.g. "INV-2026-001" or "JE-1002"
  details     String?  // Human readable description
  oldValues   String?  // JSON snapshot before modification
  newValues   String?  // JSON snapshot after modification
  ipAddress   String?
  createdAt   DateTime @default(now())

  @@index([companyId])
  @@index([companyId, entityType])
  @@index([companyId, createdAt])
}

model EWayBill {
  id              String    @id @default(uuid())
  companyId       String
  company         Company   @relation(fields: [companyId], references: [id])
  invoiceId       String?
  ewbNumber       String    @unique
  ewbDate         DateTime  @default(now())
  validUpto       DateTime
  supplyType      String    @default("Outward")
  subSupplyType   String    @default("Supply")
  docType         String    @default("Tax Invoice")
  docNo           String
  docDate         DateTime
  fromGstin       String
  fromAddress     String
  fromPincode     String
  toGstin         String
  toAddress       String
  toPincode       String
  totalValue      Decimal   @db.Decimal(19, 2)
  hsnCode         String?
  transporterId   String?
  transporterName String?
  transMode       String    @default("Road")
  distanceKm      Int       @default(50)
  vehicleNo       String?
  status          String    @default("ACTIVE")
  createdAt       DateTime  @default(now())

  @@index([companyId])
  @@index([companyId, ewbNumber])
}

model TdsEntry {
  id            String    @id @default(uuid())
  companyId     String
  company       Company   @relation(fields: [companyId], references: [id])
  vendorId      String?
  billId        String?
  vendorName    String
  vendorPan     String?
  section       String    // 194C, 194J, 194I, 194H, 194Q
  rate          Decimal   @db.Decimal(5, 2)
  taxableAmount Decimal   @db.Decimal(19, 2)
  tdsAmount     Decimal   @db.Decimal(19, 2)
  challanNo     String?
  challanDate   DateTime?
  bsrCode       String?
  status        String    @default("PENDING") // PENDING, PAID, DEPOSITED
  quarter       String    @default("Q2")
  financialYear String    @default("2026-27")
  createdAt     DateTime  @default(now())

  @@index([companyId])
  @@index([companyId, section])
  @@index([companyId, status])
}

model Employee {
  id           String       @id @default(uuid())
  companyId    String
  company      Company      @relation(fields: [companyId], references: [id])
  employeeCode String
  name         String
  email        String?
  phone        String?
  designation  String
  department   String
  joiningDate  DateTime     @default(now())
  pan          String?
  uan          String?
  esiNumber    String?
  bankAccount  String?
  bankIfsc     String?
  baseSalary   Decimal      @db.Decimal(19, 2)
  status       String       @default("Active")
  salarySlips  SalarySlip[]
  createdAt    DateTime     @default(now())

  @@unique([companyId, employeeCode])
  @@index([companyId])
}

model SalarySlip {
  id              String    @id @default(uuid())
  companyId       String
  company         Company   @relation(fields: [companyId], references: [id])
  employeeId      String
  employee        Employee  @relation(fields: [employeeId], references: [id])
  month           Int
  year            Int
  basicPay        Decimal   @db.Decimal(19, 2)
  hra             Decimal   @db.Decimal(19, 2)
  allowances      Decimal   @db.Decimal(19, 2)
  grossSalary     Decimal   @db.Decimal(19, 2)
  pfDeduction     Decimal   @db.Decimal(19, 2)
  esiDeduction    Decimal   @db.Decimal(19, 2)
  professionalTax Decimal   @db.Decimal(19, 2)
  netSalary       Decimal   @db.Decimal(19, 2)
  status          String    @default("Paid")
  paymentDate     DateTime?
  createdAt       DateTime  @default(now())

  @@unique([companyId, employeeId, month, year])
  @@index([companyId])
}

